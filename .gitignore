# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# --- Logs ---
*.log

# --- Secrets / per-deployment state (NEVER commit) ---
.env
.env.*
!*.env.example
deployments/*/.env
deployments/*/.env.*
